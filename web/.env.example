# Backend API base (server/ runs on :4000 in dev)
NEXT_PUBLIC_API_URL=http://localhost:4000
# BNB Smart Chain (56) JSON-RPC used for reads + tx receipts
NEXT_PUBLIC_BSC_RPC=https://bsc-dataseed.bnbchain.org
# Optional: WalletConnect Cloud project id (https://cloud.reown.com). Without it only injected
# (EIP-6963: MetaMask, Trust, OKX, Binance Web3…) and Coinbase Wallet are offered.
NEXT_PUBLIC_WC_PROJECT_ID=
# GachaForgeFactory on BSC mainnet. Leave empty until deployed: trading, claims and launch stay disabled.
NEXT_PUBLIC_FACTORY_ADDRESS=
# true = use bundled sample data instead of the backend
NEXT_PUBLIC_USE_MOCK=false
# Published on the Docs page once deployed (leave empty before mainnet launch)
NEXT_PUBLIC_BUYBACK_BURNER_ADDRESS=
NEXT_PUBLIC_TIMELOCK_ADDRESS=
NEXT_PUBLIC_FLAP_LAUNCHER_ADDRESS=
NEXT_PUBLIC_FORGE_ADDRESS=
