# GachaForge server — copy to .env and fill in. Never commit real secrets.
# Railway sets PORT automatically
PORT=4000
HOST=0.0.0.0
# Comma-separated. gachaforge[-*].vercel.app previews are always allowed.
CORS_ORIGINS=http://localhost:3000,https://gachaforge.xyz,https://www.gachaforge.xyz

# ── Mode ──
# offchain (default when FACTORY_ADDRESS is empty) | vault (on-chain GachaForge contracts, default with FACTORY_ADDRESS) | mock (preview: seeded data + simulator)
# MOCK_MODE=true still selects mock (use it for preview deployments).
MODE=
# Chain (56 = BSC mainnet, 97 = BSC testnet). Default: 56 in offchain mode, 97 otherwise.
# offchain: optional on 56 (falls back to FORGE_RPC_URL / public BSC RPCs); required on 97. vault: required.
RPC_URL=
CHAIN_ID=
# vault mode only (GachaForge factory contract)
FACTORY_ADDRESS=
# First block to index from (defaults to latest - 5000)
START_BLOCK=
# Company treasury = tax recipient of every machine token (offchain: registration is rejected otherwise)
TREASURY_ADDRESS=0x49060cd4C7679e7F6dB1075027F121a7c9F97a7c
# vault mode only: run operator/keeper (sends txs). false = indexer-only, no hot key needed.
OPERATOR_ENABLED=false
# Operator hot wallet (holds OPERATOR role on vaults). Required only if OPERATOR_ENABLED=true. NEVER commit a real key.
OPERATOR_PRIVATE_KEY=
# Extra addresses excluded from holder snapshots (pools/pairs, launchpad, router), comma separated
EXCLUDED_ADDRESSES=

# Renaiss card API (Builder API v2). Network defaults from CHAIN_ID: 56 → mainnet, 97 → testnet.
RENAISS_NETWORK=
# Optional base URL override (defaults: https://api.renaiss.xyz / https://dev-api.renaiss.xyz)
RENAISS_API_URL=
# Builder key (header x-builder-api-key). offchain: unset → full pots are marked pullQueued. vault: required when OPERATOR_ENABLED=true. NEVER commit a real key.
RENAISS_API_KEY=
RENAISS_TIMEOUT_MS=15000
# Optional contract overrides (defaults per network in src/renaiss/networks.ts)
USDT_ADDRESS=
RENAISS_REGISTRY=
# How often the card release job checks raffled cards waiting for Renaiss to release them (ms)
RELEASE_POLL_MS=60000

# PancakeSwap V2 BNB<->USDT (router default: mainnet 0x10ED43C718714eb63d5aA57B78B54704E256024E)
PANCAKE_ROUTER=
# Max slippage vs router quote, bps (100 = 1%)
SWAP_SLIPPAGE_BPS=100
# Extra USDT bought above the pack-price shortfall, bps
SWAP_USDT_BUFFER_BPS=10
SWAP_DEADLINE_SECONDS=180

# Postgres (optional; in-memory store when empty)
DATABASE_URL=

# true → mock mode (preview). Leave empty for offchain/vault.
MOCK_MODE=

# Fallback BNB/USD price used for display conversions
BNB_USD_PRICE=600
# Claims >= this many BNB are auto-pushed to holders
AUTO_PUSH_MIN_BNB=0.05
INDEXER_POLL_MS=3000
OPERATOR_POLL_MS=5000
SIM_INTERVAL_MS=400

# ── $FORGE token page (always BSC mainnet; independent of MOCK_MODE / CHAIN_ID) ──
# Mainnet RPC(s), comma separated. https://bsc-dataseed.bnbchain.org is always appended as fallback.
# Public RPCs keep only ~1-2 days of logs; use an archive RPC to discover a token created long before startup.
FORGE_RPC_URL=https://bsc-rpc.publicnode.com
# Public address that creates $FORGE on flap.sh. Unset → GET /api/forge returns status 'waiting' and the watcher idles.
FORGE_DEPLOYER=
# Optional: skip discovery and use this token address
FORGE_TOKEN_ADDRESS=
# Optional: first block to scan for the deployer's TokenCreated (default: chain head at first start, persisted)
FORGE_START_BLOCK=
# true → serve a clearly flagged simulated $FORGE (preview: true) until the real token is discovered
FORGE_PREVIEW=false
# Optional BuybackBurner contract: buybackPendingBnb = its BNB balance, buybackTotalBnb = Σ Buyback.bnbSpent (else 0)
BUYBACK_BURNER_ADDRESS=
FORGE_POLL_MS=5000
# Max eth_getLogs block range (adaptive: halves on RPC errors, grows back on success)
FORGE_MAX_RANGE=5000
# Metadata gateway (flap's own Pinata gateway; meta CID comes from the Portal TokenCreated event)
FORGE_IPFS_GATEWAY=https://flap.mypinata.cloud/ipfs/

# ── OFF-CHAIN MODE (docs/OFFCHAIN-OPS.md) ──
# Hot wallet that pays for pulls, payouts, burns, buybacks and dispatch gas. May be the treasury itself.
# Set it ONLY as a Railway secret. Empty → read-only: actions are recorded as QUEUED, nothing is sent.
OPS_PRIVATE_KEY=
# The key is ignored without DATABASE_URL (pots / payout queue / daily cap must survive restarts) unless this is true (local dev only)
OPS_ALLOW_MEMORY=false
# Kill switch: true → no outgoing tx at all
OPS_PAUSED=false
# Rolling 24h cap on BNB leaving the ops wallet (tx value + gas; sweeps excluded)
OPS_DAILY_CAP_BNB=1
# Gas buffer always kept in the ops wallet (sweep never touches it)
OPS_RESERVE_BNB=0.05
# Per-pull cap above the pack price at Chainlink BNB/USD (bps; 1000 = +10%)
OPS_PULL_BUFFER_BPS=1000
OPS_TX_RETRIES=3
OPS_TX_TIMEOUT_MS=180000
PULL_COOLDOWN_SEC=60
# Dividend shares below this carry over to the next round
DIVIDEND_MIN_BNB=0.0005
DIVIDEND_BATCH_SIZE=25
# $FORGE buyback & burn once the 3% buyback ledger reaches this
BUYBACK_MIN_BNB=0.05
# Machine-token buy & burn once a machine's burn bucket reaches this
BURN_MIN_BNB=0.0005
BURN_SLIPPAGE_BPS=300
# Skip TaxProcessor.dispatch() when gas > this % of the pending tax
DISPATCH_MAX_GAS_PCT=10
# Treasury-taxed Portal launches not registered within this many seconds are auto-registered (FORGE_28 / RAFFLE)
AUTO_REGISTER_DELAY_SEC=600
# Optional cold wallet for the 90% platform share (only used when the ops wallet IS the treasury)
SWEEP_TO_ADDRESS=
SWEEP_INTERVAL_MS=21600000
SWEEP_MIN_BNB=0.05
KEEPER_POLL_MS=60000
# Public-RPC friendly log scanning
LOGS_ADDRESS_BATCH=50
LOGS_MAX_RANGE=2000
# flap.sh cut estimate until real treasury receipts were measured (bps of the tax)
FLAP_CUT_ESTIMATE_BPS=1000
