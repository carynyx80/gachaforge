# GachaForge server — copy to .env and fill in. Never commit real secrets.
# Railway sets PORT automatically
PORT=4000
HOST=0.0.0.0
# Comma-separated. gachaforge[-*].vercel.app previews are always allowed.
CORS_ORIGINS=http://localhost:3000,https://gachaforge.xyz,https://www.gachaforge.xyz

# Chain (56 = BSC mainnet, 97 = BSC testnet)
# Required when FACTORY_ADDRESS is set (live mode)
RPC_URL=
CHAIN_ID=97
# Leave empty to run in MOCK_MODE with seeded data + simulator
FACTORY_ADDRESS=
# First block to index from (defaults to latest - 5000)
START_BLOCK=
# Company treasury (informational; exposed in /api/health; NOT excluded from holder eligibility)
TREASURY_ADDRESS=0x49060cd4C7679e7F6dB1075027F121a7c9F97a7c
# Run operator/keeper (sends txs). false = indexer-only, no hot key needed.
OPERATOR_ENABLED=false
# Operator hot wallet (holds OPERATOR role on vaults). Required only if OPERATOR_ENABLED=true. NEVER commit a real key.
OPERATOR_PRIVATE_KEY=
# Extra addresses excluded from holder snapshots (pools/pairs, launchpad, router), comma separated
EXCLUDED_ADDRESSES=

# Renaiss card API
RENAISS_API_URL=
RENAISS_API_KEY=

# Postgres (optional; in-memory store when empty)
DATABASE_URL=

# true/false; defaults to true when FACTORY_ADDRESS is empty
MOCK_MODE=

# Fallback BNB/USD price used for display conversions
BNB_USD_PRICE=600
# Claims >= this many BNB are auto-pushed to holders
AUTO_PUSH_MIN_BNB=0.05
INDEXER_POLL_MS=3000
OPERATOR_POLL_MS=5000
SIM_INTERVAL_MS=3000
