# --- RPC / deployer (never commit real values) ---
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
ETHERSCAN_API_KEY=
# deploy with: forge script script/Deploy.s.sol --rpc-url bsc --broadcast --account <keystore>

# --- GachaForge config ---
# Chainlink BNB/USD (BSC mainnet). Verify on data.chain.link before use.
CHAINLINK_BNB_USD=0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE
PRICE_MAX_AGE=3600
TREASURY=0x0000000000000000000000000000000000000000
# 2-of-3 Safe: proposer + executor of the TimelockController (placeholder)
MULTISIG=0x0000000000000000000000000000000000000000
OPERATOR=0x0000000000000000000000000000000000000000
FORGE_TOKEN=0x0000000000000000000000000000000000000000
RENAISS_PAYMENT_RECEIVER=0x0000000000000000000000000000000000000000
TIMELOCK_DELAY=172800

# --- flap.sh (BSC mainnet, see docs/flap-integration.md) ---
FLAP_PORTAL=0xe2cE6ab80874Fa9Fa2aAE65D277Dd6B8e65C9De0
# set to 0x0 to use Portal.newTokenV6 (beneficiary = vault) instead of VaultPortal
FLAP_VAULT_PORTAL=0x90497450f2a706f1951b5bdda52B4E5d16f34C06
FLAP_TAX_TOKEN_IMPL=0x024f18294970B5c76c0691b87f138A0317156422
# seconds; max accepted by newTokenV6 is UNVERIFIED (fork-test it)
FLAP_TAX_DURATION=3153600000
FLAP_ANTI_FARMER_DURATION=259200
# PancakeSwap V2 router (BSC mainnet)
PANCAKE_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
